{
  "name": "ByteSavor",
  "appid": "__UNI__BYTESAVOR",
  "description": "字节品鉴者 - 智能食谱推荐",
  "versionName": "3.0.0",
  "versionCode": "300",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": false,
      "waiting": false,
      "autoclose": false,
      "delay": 0
    },
    "modules": {},
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.CAMERA\"/>",
          "<uses-feature android:name=\"android.hardware.camera\"/>"
        ]
      },
      "ios": {},
      "sdkConfigs": {}
    }
  },
  "quickapp": {},
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true
    },
    "usingComponents": true,
    "permission": {
      "scope.camera": {
        "desc": "用于拍照识别食材"
      },
      "scope.writePhotosAlbum": {
        "desc": "用于保存菜谱图片"
      }
    },
    "requiredPrivateInfos": ["chooseImage", "chooseMedia"],
    "lazyCodeLoading": "requiredComponents"
  },
  "mp-alipay": {
    "usingComponents": true
  },
  "mp-baidu": {
    "usingComponents": true
  },
  "mp-toutiao": {
    "usingComponents": true
  },
  "uniStatistics": {
    "enable": false
  },
  "vueVersion": "3"
}

# ByteSavor local example config.
# Copy to .env and fill local values. Never commit real .env or API keys.

APP_NAME=ByteSavor
DEBUG=true

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=bytesavor
MYSQL_DB=bytesavor

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# VLM - OpenAI-compatible Qwen-VL/DashScope.
# Leave empty to test non-vision flows.
VLM_API_URL=
VLM_API_KEY=
VLM_MODEL=qwen-vl-max
VLM_TIMEOUT_SEC=80

# Optional aliases for Qwen-compatible deployments.
QWEN_VL_API_URL=
QWEN_VL_API_KEY=
QWEN_VL_MODEL=

# LLM - DeepSeek/OpenAI-compatible/Ollama.
# Leave empty to use deterministic fallback logic.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SEC=15

# Optional Agent LLM switches. Keep false for deterministic local testing.
AGENT_LLM_PLANNER_ENABLED=false
AGENT_LLM_JUDGE_ENABLED=false

# ByteSavor V3.0 环境配置
APP_NAME=ByteSavor V3.0
DEBUG=true

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=bytesavor

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# VLM - Qwen-VL (DashScope)
VLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VLM_API_KEY=your-dashscope-key-here
VLM_MODEL=qwen-vl-max

# LLM - Ollama 本地
LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:1.5b
